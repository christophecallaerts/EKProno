@page
@model EKProno.Pages.Pools.IndexModel
@{
    ViewData["Title"] = "My pools";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">My pools</h1>
    <a class="btn btn-primary" asp-page="Create">Create a pool</a>
</div>

@if (Model.Pools.Count == 0)
{
    @* FR-012: a first-time organiser is pointed straight at creating their first pool. *@
    <div class="card">
        <div class="card-body text-center py-5">
            <h2 class="h4">You have no pools yet</h2>
            <p class="text-muted">
                A pool is where you and your friends predict one tournament together.
            </p>
            <a class="btn btn-primary btn-lg" asp-page="Create">Create your first pool</a>
        </div>
    </div>
}
else
{
    <ul class="list-group">
        @foreach (var pool in Model.Pools)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <div class="fw-semibold">@pool.Name</div>
                    <div class="text-muted small">@pool.TournamentName</div>
                </div>
                <div class="d-flex gap-2">
                    <a class="btn btn-outline-secondary btn-sm"
                       asp-page="Schedule" asp-route-id="@pool.Id">Schedule</a>
                    <a class="btn btn-outline-secondary btn-sm"
                       asp-page="Rename" asp-route-id="@pool.Id">Rename</a>
                </div>
            </li>
        }
    </ul>
}
